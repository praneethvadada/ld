# Copy this file to .env to override the defaults. All values are optional.

# Where the browser sends API requests. Leave empty when the API is on the same
# domain as the website (the recommended Nginx setup proxies /api to the backend).
VITE_API_BASE_URL=

# Link to the main website. When set, the header logo links to it and the
# header and banner show a button to it.
VITE_MAIN_SITE_URL=

# Development only: the backend that Vite forwards /api requests to.
API_PROXY_TARGET=http://localhost:5050
