# Copy this file to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=5050

# Comma-separated list of website origins allowed to call the API.
# Production example: https://luckydraw.example.com
CORS_ORIGIN=http://localhost:5173

# Lucky draw check: maximum requests per IP address per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Number of reverse proxies in front of this server: 1 behind Nginx, 0 when run directly.
TRUST_PROXY=0

# Participants: one per line, written as  name,phone_number,is_winner
# This is the only place phone numbers are stored. Generate it from your sheet with:
#   npm run seed -- path/to/participants.csv
PARTICIPANTS="
Praneeth,9876543210,true
Rahul,9876543211,false
Suresh,9876543212,true
Anil,9876543213,false
Kiran,9876543214,true
"
